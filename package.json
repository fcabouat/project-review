{
  "name": "project-review-workspace",
  "private": true,
  "version": "0.1.1",
  "description": "Workspace: pure domain core, Svelte component library, and the single-page app that derives a full project-review slideshow from one portfolio file.",
  "license": "MIT",
  "author": "François Cabouat",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "app",
    "packages/*"
  ],
  "scripts": {
    "dev": "cd app && node --run dev",
    "build": "cd app && node --run build && cd .. && node scripts/build-notices.ts",
    "preview": "cd app && node --run preview",
    "check": "cd packages/core && node --run check && cd ../components && node --run check && cd ../infrastructure && node --run check && cd ../../app && node --run check",
    "test": "node --test app/tests-smoke/server.test.mjs && vitest run",
    "test:coverage": "node --test app/tests-smoke/server.test.mjs && vitest run --coverage",
    "test:watch": "vitest",
    "smoke": "node app/tests-smoke/smoke.mjs",
    "a11y": "node app/tests-smoke/a11y.mjs",
    "storybook": "cd packages/components && node --run storybook",
    "build-storybook": "cd packages/components && node --run build-storybook",
    "lint": "eslint . && node scripts/lint-probes.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "audit": "pnpm audit",
    "deps:check": "pnpm outdated",
    "docs:api": "typedoc",
    "docs:notices": "node scripts/build-notices.ts",
    "docs:examples": "node scripts/build-examples.mjs",
    "docs:site": "node scripts/build-site.ts && node --test scripts/site-nav.test.mjs"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.3.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-svelte-csf": "5.1.3",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/svelte-vite": "^10.6.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "5.0.0",
    "ajv": "^8.20.0",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "knip": "^6.34.0",
    "marked": "^18.0.12",
    "playwright": "1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "storybook": "^10.6.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.0"
  }
}
