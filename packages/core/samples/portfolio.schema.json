{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "portfolio.schema.json",
  "title": "Portfolio — project review",
  "description": "Schema of the portfolio file (editor export \"project-review-{reviewDate}.json\", sample sets \"sample-portfolio.{fr,en}.json\"). It states the SAME closed contract the application's strict import enforces (core parse/): required keys, no unknown key, closed enumerations, bounded numbers. Four checks only the parse can express: dates must be CALENDAR-valid (the pattern here just fixes the shape), ids must be unique per collection, the embedded font faces together must stay under 2 000 000 data-URI characters (~1.5 MB of binary), and categories, projects and free slides TOGETHER must not exceed 2000 entities (the per-array maxItems below states the weaker bound this schema can express).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "review", "settings", "categories", "projects", "freeSlides"],
  "definitions": {
    "paletteColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "description": "Exact six-digit hexadecimal — the shape the parse and the editor's commands both enforce (core values/palette.ts)"
    },
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "color": {
      "enum": [
        "blue",
        "indigo",
        "teal",
        "cyan",
        "green",
        "olive",
        "amber",
        "orange",
        "red",
        "purple",
        "brown",
        "taupe"
      ]
    },
    "stage": {
      "enum": ["toScope", "ready", "inProgress", "residuals", "closed", "abandoned"]
    },
    "healthLevel": {
      "enum": ["onTrack", "watch", "alert", "critical"]
    },
    "priority": {
      "enum": ["P1", "P2", "P3"]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question"],
      "properties": {
        "question": {
          "type": "string",
          "description": "A closed question the review session can settle"
        },
        "decider": {
          "type": "string"
        },
        "taken": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "when"],
          "properties": {
            "text": {
              "type": "string"
            },
            "when": {
              "$ref": "#/definitions/isoDate"
            }
          }
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "date", "done"],
      "properties": {
        "label": {
          "type": "string"
        },
        "date": {
          "$ref": "#/definitions/isoDate"
        },
        "display": {
          "type": "string"
        },
        "done": {
          "type": "boolean"
        }
      }
    }
  },
  "properties": {
    "version": {
      "const": 3
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "reviewDate"],
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "reviewDate": {
          "$ref": "#/definitions/isoDate"
        },
        "previousReviewDate": {
          "$ref": "#/definitions/isoDate"
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "show", "recapRows"],
      "properties": {
        "language": {
          "enum": ["fr", "en"],
          "default": "fr"
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["org", "unit"],
          "properties": {
            "org": {
              "type": "string"
            },
            "unit": {
              "type": "string"
            },
            "orgLong": {
              "type": "string"
            },
            "unitLong": {
              "type": "string"
            },
            "contact": {
              "type": "string"
            },
            "logo": {
              "type": "string",
              "pattern": "^data:image\\/",
              "maxLength": 400000,
              "description": "Logo inlined as a data URI (SVG/PNG/JPEG/WebP); absent → bundled Déjà Vu logo"
            }
          }
        },
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "style": {
              "enum": ["flat", "institutional", "modern"],
              "default": "flat"
            },
            "palette": {
              "enum": ["material", "tailwind", "uniform"],
              "default": "material"
            },
            "font": {
              "type": "string",
              "pattern": "^[A-Za-z0-9 _-]{1,64}$",
              "default": "Roboto"
            },
            "fontFaces": {
              "type": "array",
              "description": "Font faces embedded in the portfolio as woff2 data URIs — the theme font travels inside the file. All faces together must stay under 2 000 000 data-URI characters (~1.5 MB of binary); only the parse counts that total.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["family", "dataUri"],
                "properties": {
                  "family": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9 _-]{1,64}$"
                  },
                  "weight": {
                    "type": "string",
                    "pattern": "^\\d{3}( \\d{3})?$",
                    "default": "400",
                    "description": "One integer in 400–800, or an ascending \"min max\" pair"
                  },
                  "style": {
                    "enum": ["normal", "italic"],
                    "default": "normal"
                  },
                  "dataUri": {
                    "type": "string",
                    "pattern": "^data:font\\/woff2;base64,[A-Za-z0-9+/]+={0,2}$",
                    "maxLength": 550000
                  }
                }
              }
            },
            "customPalette": {
              "type": "object",
              "additionalProperties": false,
              "required": ["colors"],
              "description": "The twelve category colours carried BY THE PORTFOLIO instead of chosen among the built-in families — it takes precedence over \"palette\" for as long as it is there. The table is exhaustive: the twelve names of the domain, no more and no less.",
              "properties": {
                "label": {
                  "type": "string",
                  "description": "What to call it in the interface; absent → a generic label"
                },
                "colors": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "blue",
                    "indigo",
                    "teal",
                    "cyan",
                    "green",
                    "olive",
                    "amber",
                    "orange",
                    "red",
                    "purple",
                    "brown",
                    "taupe"
                  ],
                  "properties": {
                    "blue": { "$ref": "#/definitions/paletteColor" },
                    "indigo": { "$ref": "#/definitions/paletteColor" },
                    "teal": { "$ref": "#/definitions/paletteColor" },
                    "cyan": { "$ref": "#/definitions/paletteColor" },
                    "green": { "$ref": "#/definitions/paletteColor" },
                    "olive": { "$ref": "#/definitions/paletteColor" },
                    "amber": { "$ref": "#/definitions/paletteColor" },
                    "orange": { "$ref": "#/definitions/paletteColor" },
                    "red": { "$ref": "#/definitions/paletteColor" },
                    "purple": { "$ref": "#/definitions/paletteColor" },
                    "brown": { "$ref": "#/definitions/paletteColor" },
                    "taupe": { "$ref": "#/definitions/paletteColor" }
                  }
                }
              }
            }
          }
        },
        "show": {
          "type": "object",
          "additionalProperties": false,
          "required": ["healthDashboard", "recap", "archives", "decisions"],
          "properties": {
            "healthDashboard": {
              "type": "boolean"
            },
            "recap": {
              "type": "boolean"
            },
            "archives": {
              "type": "boolean"
            },
            "decisions": {
              "type": "boolean"
            }
          }
        },
        "recapRows": {
          "type": "integer",
          "minimum": 6,
          "maximum": 16
        }
      }
    },
    "categories": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "color"],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "$ref": "#/definitions/color"
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "categoryId",
          "stage",
          "onHold",
          "goal",
          "done",
          "ongoing",
          "next",
          "decisions",
          "milestones",
          "sheet"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "name": {
            "type": "string"
          },
          "categoryId": {
            "type": "string",
            "description": "A category id, or \"\" while the project is unassigned"
          },
          "priority": {
            "$ref": "#/definitions/priority"
          },
          "stage": {
            "$ref": "#/definitions/stage"
          },
          "onHold": {
            "type": "boolean"
          },
          "health": {
            "$ref": "#/definitions/healthLevel"
          },
          "progress": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "lead": {
            "type": "string"
          },
          "sponsor": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "budget": {
            "type": "string"
          },
          "start": {
            "$ref": "#/definitions/isoDate"
          },
          "targetEnd": {
            "$ref": "#/definitions/isoDate"
          },
          "actualEnd": {
            "$ref": "#/definitions/isoDate"
          },
          "done": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ongoing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risks": {
            "type": "string"
          },
          "decisions": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/decision"
            }
          },
          "milestones": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/milestone"
            }
          },
          "sheet": {
            "enum": ["auto", "always", "never"]
          },
          "updatedOn": {
            "$ref": "#/definitions/isoDate"
          },
          "author": {
            "type": "string"
          }
        }
      }
    },
    "freeSlides": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "anchor", "title", "blocks"],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "anchor": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": {
                    "enum": ["opening", "closing"]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "categoryId"],
                "properties": {
                  "type": {
                    "const": "beforeCategory"
                  },
                  "categoryId": {
                    "$ref": "#/definitions/id"
                  }
                }
              }
            ]
          },
          "title": {
            "type": "string"
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "One bullet line — **bold** and a trailing \" — detail\" suffix only"
              }
            }
          }
        }
      }
    }
  }
}
